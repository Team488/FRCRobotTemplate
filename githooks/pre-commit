#!/usr/bin/env bash
# Checks staged .java files against Spotless before each commit (see
# spotless-staged.sh for exactly what happens if something isn't formatted
# correctly).
#
# Enable once per clone with:
#   git config core.hooksPath githooks
set -euo pipefail
exec "$(git rev-parse --show-toplevel)/githooks/spotless-staged.sh"
